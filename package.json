{
  "name": "slides-library-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "format:check": "prettier --check frontend vite.config.ts tsconfig.json package.json",
    "format": "prettier --write frontend vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vue-tsc": "3.3.14"
  }
}
